@page "/datacollection"
@using OOPsDemo
@rendermode InteractiveServer
<h3>DataCollection</h3>

<h4> Write Employment data to CSV file</h4>

<blockquote>
    This component will demonstrate how your page can handle validation of data input,
    showing validation messages when you have a number of controls for data entry. This
    component will validate the local controls and create any validation messages for
    invalid data. The messages can be collected using various techniques such as: List or
    Dictionary.
</blockquote>


@* Display Feedback Messages *@
@if (feedbackMessage.Length > 0 )
{
    <div class=" alert alert-info"> 
        @feedbackMessage
   </div>
}

@* Display Error Messages *@

@if (errorDictionary.Count > 0)
{
    <div class=" alert alert-danger">

        <p> Please fix the following errors:</p>
        <ul> 
            @foreach (var message in errorDictionary.Values)
            {
                <li> @message</li>
            }
        </ul>
        
    </div>
}


@* create input controls to recieve Employment data *@

<fieldset>
    <div>
        <label for="title"> Position Title :  </label>
        <input id="title" type="text" @bind="employmentTitle" />
    </div>

    <div>
        <label for="startdate"> Position Start Date :  </label>
        <input id="startdate" type="date" @bind="empStartDate" />

    </div>

    <div>
        <label for="years"> Years :  </label>
        <input id="years" type="number" @bind="empYears" step="0.1" />
    </div>

    <div>
        <label for="level"> Supervisory Level :  </label>
        <select id="level" @bind="empLevel" >
        @foreach ( var item in Enum.GetValues(typeof(SupervisoryLevel)))
            {
                //each Enum will consider the value as a string
                //the value attribute is the value returned when a choice has been made
                //the string between the opening and closing tag will be displayed to the user
                <option value="@item"> @item </option>

            }
            
        </select>

    </div>

    <br />
    <div>
        <button type="submit" @onclick="Data_Collection">Collect </button>
        &nbsp;&nbsp;
        <button type="submit" @onclick="Clear"> Clear </button>
    </div>
    
</fieldset>

@code {
    // All variables used in the program should be declared here
    private string feedbackMessage = "";
    private Dictionary<string, string> errorDictionary = new(); // name, explaination 
    // variables to store Employment values entered by user

    private string employmentTitle;
    private DateTime empStartDate;
    private double empYears;
    private SupervisoryLevel empLevel;

    //one could use a class definition as the receiving variable
    //       fields for your controls
    //if you use this technique then you would need to declare
    //  your variable with a new (); so that there is an
    //  instance in existance.
    private Employment employment = null;

    //

    // define Methods

    public void Clear()
    {
        feedbackMessage = "";
        errorDictionary.Clear();
        employmentTitle = "";
        empStartDate = DateTime.Today;
        empLevel = SupervisoryLevel.Entry;
        empYears = 0;

    }

    public void Data_Collection()
    {
        feedbackMessage = "";
        errorDictionary.Clear();

        // apply validation before we use local variables to create Employment object

        // check for Title

        if ( string.IsNullOrWhiteSpace(employmentTitle))
        { errorDictionary.Add("Title", "Title is required");
        }

        // check for start date : it should not be greater than current date

        if (empStartDate > DateTime.Today.AddDays(1))
        {
            errorDictionary.Add("StartDate", "Start date can't be in future");
        }

        if (!Utilities.IsZeroOrPositive(empYears))
        {
            errorDictionary.Add("Years", "Years of Experience should be a positive value");
        }

        if (errorDictionary.Count == 0)
        {
            feedbackMessage = " Good Data";

            try
            {
                employment = new Employment(employmentTitle, empLevel, empStartDate, empYears);

                // convert employment obj into string

                string rline = $"{employment.ToString()}";
                feedbackMessage = rline;
            }
            catch{}




        }


    }
}
