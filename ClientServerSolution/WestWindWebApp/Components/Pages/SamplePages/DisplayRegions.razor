@page "/regionsquery"
<PageTitle> Region Queries</PageTitle>
@rendermode InteractiveServer

<!-- Additional Namespaces-->
@using ClassWestWindSystem.BLL;
@using ClassWestWindSystem.Entity;

<h3>DisplayRegions</h3>
@if (feedBackMsg.Length > 0)
{
    <div class="alert alert-info">
        <p>@feedBackMsg</p>
    </div>
}

@if (errorMsgs.Count > 0)
{
    <div class="alert alert-danger">
        <p>Please fix the following issues:</p>
        <ul>
            @foreach (var error in errorMsgs)
            {
                <li>@error</li>
            }
        </ul>
    </div>
}

<!-- create the form for the query-->
@*
    form area
    standard html controls
    use bootstrap for formating
    form will be two column
*@



@*  <div class="row">
        <div class="offset-3 col-md-6 overflow-scroll" style="height:250px;">
            <table class="table table-striped">
                <thead style="position:sticky; top:0; background-color:white;">
                    <tr>
                        <th>RegionID</th>
                        <th>RegionDescription</th>
                        
                    </tr>
                </thead>
                <tbody>
                    @foreach (var regionr in regions)
                    {
                        <tr>
                            <td>@regionr.RegionId</td>
                            <td>@regionr.RegionDescription</td>
                        </tr>
                    }
            </tbody>
        </table>
    </div>
</div> *@

<div class="row">
    <div class="col-md-6">
        <!-- this column will hold the query input controls and buttons-->
        <p> Area to provide input from user: text box or drop down list</p>
        <label for="regionid">Enter a region id:</label>&nbsp;&nbsp;
        <input id="regionid" type="number" @bind="entryarg"
               placeholder="enter region id" style="width:100px;" />&nbsp;&nbsp;
        <button type="submit" class="btn btn-outline-secondary rounded-pill"
                @onclick="GetByID">
            Fetch By Entry
        </button>
                   
        <br /><br />

        <label for="selectid">Select a region:</label>&nbsp;&nbsp;
        <select id="selectid" style="width:100px;" @bind = "selectarg">
            <option value="0">... select</option>
            @foreach (var item in regions)
            {
                <option value="@item.RegionId">@item.RegionDescription</option>
            }
        </select>&nbsp;&nbsp;
        <button type="submit" class="btn btn-outline-secondary rounded-pill"
                @onclick="GetBySelection">
            Fetch By Selection
        </button>
        
    </div>
    <div class="col-md-6">
        <!-- this column will hold the query result output
                no output attempt will be done unless the page actaully
                has something to display
        -->
        <p> Area to display results based on the input given by user</p>
        <br /><br />
        @if (region != null)
        {
            <p>Region ID: @region.RegionId</p>
            <p>Region Description: @region.RegionDescription</p>
        }
        @if (region == null)
        {
            <p>Region value is null</p>
        }
    </div>
</div>

@code {

    private string feedBackMsg = "";
    private List<string> errorMsgs = new();

    //variables for the input controls
    private int entryarg = 0;
    private int selectarg = 0;

    Region region = null;
    List<Region> regions = new();

    //inject services for Region
    [Inject]
    private RegionServices _regionServices { get; set; }

    protected override void OnInitialized()
    {
        //need this method as the select collection needs to exist as the page
        //  first appears
        //consume a Region service
        regions = _regionServices.Region_GetList();
        base.OnInitialized();
    }

    // all methods to be used in page can be defined here

    private void GetByID()
    {
        feedBackMsg = "";
        errorMsgs.Clear();
        region = null;

        //validate the incoming argument value is correct
        if (entryarg == 0)
        {
            errorMsgs.Add($"You must enter a valid region to query.");
        }

        //did you find any invalid data
        if (errorMsgs.Count == 0)
        {
            //at this point data appears to be good
            //consume a service and catch results
            region = _regionServices.Region_GetByID(entryarg);
            //check the results
            if (region == null)
            {
                //since the select control is based on the database records
                //  it is highly unlikely you will ever get this message
                feedBackMsg = $"There is no region data for the selected region";
            }

        }
    }

    private void GetBySelection()
    {
        feedBackMsg = "";
        errorMsgs.Clear();
        region = null;

        //validate the incoming argument value is correct
        if (selectarg == 0)
        {
            errorMsgs.Add($"You must select a region to query.");
        }

        //did you find any invalid data
        if (errorMsgs.Count == 0)
        {
            //at this point data appears to be good
            //consume a service and catch results
            region = _regionServices.Region_GetByID(selectarg);
            //check the results
            if (region == null)
            {
                //since the select control is based on the database records
                //  it is highly unlikely you will ever get this message
                feedBackMsg = $"There is no region data for the selected region";
            }

        }
    }



}
